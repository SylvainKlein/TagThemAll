<Window x:Class="TagThemAll.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TagThemAll.ViewModels"
        xmlns:models="clr-namespace:TagThemAll.Models"
        mc:Ignorable="d"
        Title="TagThemAll — Universal File Tagger"
        Icon="Resources/app.ico"
        Height="850" Width="1360"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDarkest}"
        Foreground="{StaticResource BrushTextPrimary}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="A"      Modifiers="Ctrl" Command="{Binding SelectAllCommand}" />
        <KeyBinding Key="Escape"                  Command="{Binding DeselectAllCommand}" />
        <KeyBinding Key="Delete"                  Command="{Binding RemoveSelectedFromCatalogCommand}" />
        <KeyBinding Key="F5"                      Command="{Binding RefreshThumbnailsCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header Bar -->
            <RowDefinition Height="Auto" />  <!-- Filters Bar -->
            <RowDefinition Height="*"    />  <!-- Content -->
            <RowDefinition Height="Auto" />  <!-- Tagging Dock -->
            <RowDefinition Height="Auto" />  <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════
             1 ▸ TOP HEADER BAR
             ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgDark}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Width="34" Height="34" CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Resources/app-icon.png"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="Uniform" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TagThemAll" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="Universal local file catalog" FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Search Bar -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" Width="580" MaxWidth="700">
                    <Border Background="{StaticResource BrushBgSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="6,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Data="{StaticResource IconSearch}"
                                  Fill="{StaticResource BrushTextMuted}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Margin="6,0,8,0" VerticalAlignment="Center" />

                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{StaticResource BrushTextPrimary}"
                                     BorderThickness="0" FontSize="13"
                                     VerticalAlignment="Center"
                                     CaretBrush="{StaticResource BrushAccent}">
                                <TextBox.Resources>
                                    <VisualBrush x:Key="PH" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                        <VisualBrush.Visual>
                                            <TextBlock Text="Search by tags (e.g. night, portrait) or file name..."
                                                       Foreground="{StaticResource BrushTextDim}"
                                                       FontStyle="Italic" FontSize="13" />
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </TextBox.Resources>
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background" Value="{StaticResource PH}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <!-- Clear search -->
                            <Button Grid.Column="2"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding SearchQuery.Length, Converter={StaticResource CountToVisConverter}}"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Padding="4" Margin="2,0">
                                <Path Data="{StaticResource IconClose}"
                                      Fill="{StaticResource BrushTextMuted}"
                                      Width="12" Height="12" Stretch="Uniform" />
                            </Button>

                            <!-- Search target switcher -->
                            <Border Grid.Column="3" Background="{StaticResource BrushBgDark}"
                                    CornerRadius="6" Margin="6,0,2,0" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Tags"     IsChecked="{Binding IsSearchByTags}" Style="{StaticResource FilterPill}" Margin="1" Padding="8,3" FontSize="11" />
                                    <RadioButton Content="Name"     IsChecked="{Binding IsSearchByName}" Style="{StaticResource FilterPill}" Margin="1" Padding="8,3" FontSize="11" />
                                    <RadioButton Content="All"      IsChecked="{Binding IsSearchByBoth}" Style="{StaticResource FilterPill}" Margin="1" Padding="8,3" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Zoom slider (grid view only) -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisConverter}}"
                                Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Zoom" FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider Width="100" Minimum="96" Maximum="280"
                                Value="{Binding ThumbnailSize}"
                                Style="{StaticResource ModernSlider}" />
                    </StackPanel>

                    <!-- View switcher -->
                    <Border Background="{StaticResource BrushBgSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton IsChecked="{Binding IsGridView}" ToolTip="Grid view (thumbnails)"
                                         Style="{StaticResource FilterPill}" Padding="8,5" Margin="1">
                                <Path Data="{StaticResource IconGrid}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="14" Height="14" Stretch="Uniform" />
                            </RadioButton>
                            <RadioButton IsChecked="{Binding IsListView}" ToolTip="List view"
                                         Style="{StaticResource FilterPill}" Padding="8,5" Margin="1">
                                <Path Data="{StaticResource IconList}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="14" Height="14" Stretch="Uniform" />
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Import button -->
                    <Button Click="AddFilesButton_Click" Style="{StaticResource AccentButton}"
                            Padding="12,6" ToolTip="Import files or folders">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconFolder}" Fill="#ffffff"
                                  Width="14" Height="14" Stretch="Uniform"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="+ Import" FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════
             2 ▸ FILTERS &amp; SORT BAR
             ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource BrushBgDarkest}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Filter pills -->
                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="All files"   IsChecked="{Binding IsFilterAll}"       Style="{StaticResource FilterPill}" Margin="0,0,6,0" />

                        <!-- UNLINKED pill -->
                        <RadioButton IsChecked="{Binding IsFilterUnlinked}" Style="{StaticResource UnlinkedPill}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUnlinked}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="UNLINKED" FontWeight="Bold" />
                                <Border Background="#dc2626" CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                        Visibility="{Binding UnlinkedCount, Converter={StaticResource CountToVisConverter}}">
                                    <TextBlock Text="{Binding UnlinkedCount}" Foreground="#ffffff" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <!-- UNTAGGED -->
                        <RadioButton IsChecked="{Binding IsFilterUntagged}" Style="{StaticResource FilterPill}" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Untagged" />
                                <Border Background="#3f3f4e" CornerRadius="8" Padding="6,1" Margin="6,0,0,0"
                                        Visibility="{Binding UntaggedCount, Converter={StaticResource CountToVisConverter}}">
                                    <TextBlock Text="{Binding UntaggedCount}" Foreground="#e4e4e7" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Content="Images"    IsChecked="{Binding IsFilterImages}"    Style="{StaticResource FilterPill}" Margin="0,0,6,0" />
                        <RadioButton Content="Videos"    IsChecked="{Binding IsFilterVideos}"    Style="{StaticResource FilterPill}" Margin="0,0,6,0" />
                        <RadioButton Content="Audio"     IsChecked="{Binding IsFilterAudio}"     Style="{StaticResource FilterPill}" Margin="0,0,6,0" />
                        <RadioButton Content="Documents" IsChecked="{Binding IsFilterDocuments}" Style="{StaticResource FilterPill}" Margin="0,0,6,0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Sort + Select All -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sort by:" FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />

                    <ComboBox SelectedValue="{Binding SelectedSort}"
                              SelectedValuePath="Tag"
                              Style="{StaticResource ModernComboBox}"
                              Width="140" Margin="0,0,4,0"
                              MaxDropDownHeight="220">
                        <ComboBoxItem Content="Date added"      Tag="{x:Static models:SortField.DateAdded}" />
                        <ComboBoxItem Content="File name"       Tag="{x:Static models:SortField.Name}" />
                        <ComboBoxItem Content="Date modified"   Tag="{x:Static models:SortField.DateModified}" />
                        <ComboBoxItem Content="File size"       Tag="{x:Static models:SortField.FileSize}" />
                        <ComboBoxItem Content="Tag count"       Tag="{x:Static models:SortField.TagCount}" />
                    </ComboBox>

                    <Button Command="{Binding ToggleSortOrderCommand}"
                            Style="{StaticResource ModernButton}"
                            Padding="8,5" Margin="0,0,10,0" ToolTip="Reverse sort order">
                        <TextBlock FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="↓ Desc" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SortAscending}" Value="True">
                                            <Setter Property="Text" Value="↑ Asc" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <Rectangle Width="1" Height="20" Fill="{StaticResource BrushBorder}" Margin="0,0,10,0" />

                    <Button Command="{Binding SelectAllCommand}"
                            Style="{StaticResource ModernButton}"
                            Padding="10,5" ToolTip="Select all visible files (Ctrl+A)">
                        <TextBlock Text="Select all" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════
             3 ▸ MAIN CONTENT — GRID OR LIST VIEW
             ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Background="{StaticResource BrushBgDarkest}">

            <!-- Empty catalog placeholder -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding TotalCount, Converter={StaticResource InverseCountToVisConverter}}">
                <Border Width="80" Height="80"
                        Background="{StaticResource BrushBgSurface}"
                        CornerRadius="40" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path Data="{StaticResource IconDrop}" Fill="{StaticResource BrushAccent}"
                          Width="40" Height="40" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="No files in the catalog yet" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextPrimary}"
                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Drag &amp; drop files or folders here to get started!"
                           FontSize="14" Foreground="{StaticResource BrushTextMuted}"
                           HorizontalAlignment="Center" Margin="0,0,0,16" />
                <Button Click="AddFilesButton_Click" Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Center" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolder}" Fill="#ffffff"
                              Width="16" Height="16" Stretch="Uniform"
                              Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Browse files..." FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Empty filter result placeholder -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding TotalCount, Converter={StaticResource CountToVisConverter}}" Value="Visible" />
                                    <Condition Binding="{Binding FilteredCount}" Value="0" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Path Data="{StaticResource IconSearch}"
                      Fill="{StaticResource BrushTextDim}"
                      Width="48" Height="48" Stretch="Uniform"
                      HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Text="No files match the current filter or search"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextMuted}"
                           HorizontalAlignment="Center" Margin="0,0,0,8" />
                <Button Command="{Binding ClearSearchCommand}"
                        Style="{StaticResource ModernButton}"
                        HorizontalAlignment="Center" Padding="12,6">
                    <TextBlock Text="Clear search" />
                </Button>
            </StackPanel>

            <!-- ── A. GRID VIEW (thumbnails) ── -->
            <Grid Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisConverter}}">
                <!-- Rubber-band selection canvas (visual overlay, lets clicks pass through to cards) -->
                <Canvas x:Name="SelectionCanvas"
                        IsHitTestVisible="False"
                        ClipToBounds="True"
                        Panel.ZIndex="10">
                    <!-- Selection rectangle drawn during rubber-banding -->
                    <Border x:Name="SelectionRect"
                            BorderBrush="{StaticResource BrushAccent}"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource AccentColor}" Opacity="0.18" />
                        </Border.Background>
                    </Border>
                </Canvas>

                <ScrollViewer x:Name="GridScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16"
                              Panel.ZIndex="0">
                    <ListBox x:Name="GridListBox"
                             ItemsSource="{Binding FilteredFilesView}"
                             SelectionMode="Extended"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="GridListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="GridListBox_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="GridListBox_PreviewMouseLeftButtonUp"
                             MouseDoubleClick="GridListBox_MouseDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="IsSelected"   Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Margin"       Value="6" />
                                <Setter Property="Padding"      Value="0" />
                                <Setter Property="Background"   Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                <Border x:Name="CardBorder"
                                        Width="{Binding DataContext.ThumbnailSize,
                                               RelativeSource={RelativeSource AncestorType=Window}}"
                                        Background="{StaticResource BrushBgSurface}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1" CornerRadius="8" Cursor="Hand" Margin="2">
                                    <Border.ContextMenu>
                                        <ContextMenu Background="{StaticResource BrushBgSurface}"
                                                     Foreground="{StaticResource BrushTextPrimary}"
                                                     BorderBrush="{StaticResource BrushBorder}">
                                            <MenuItem Header="Open file"
                                                      Command="{Binding DataContext.OpenFileCommand,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Show in Explorer"
                                                      Command="{Binding DataContext.ShowInExplorerCommand,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator Background="{StaticResource BrushBorder}" />
                                            <MenuItem Header="Relink this file..."
                                                      Command="{Binding DataContext.RelinkSelectedCommand,
                                                                RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <MenuItem Header="Copy absolute path" Click="CopyPathMenuItem_Click" />
                                            <Separator Background="{StaticResource BrushBorder}" />
                                            <MenuItem Header="Remove from catalog"
                                                      Command="{Binding DataContext.RemoveSelectedFromCatalogCommand,
                                                                RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- ── Thumbnail area ── -->
                                        <Border Grid.Row="0"
                                                Height="{Binding Width, RelativeSource={RelativeSource Self}}"
                                                Background="#141418"
                                                CornerRadius="7,7,0,0"
                                                ClipToBounds="True">
                                            <Grid>
                                                <!-- Thumbnail image -->
                                                <Image Source="{Binding Thumbnail}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding IsUnlinked, Converter={StaticResource InverseBoolToVisConverter}}" />

                                                <!-- Spinner while loading -->
                                                <Border Visibility="{Binding IsLoadingThumbnail,
                                                                     Converter={StaticResource BoolToVisConverter}}"
                                                        Background="Transparent"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="…" Foreground="{StaticResource BrushTextDim}"
                                                               FontSize="20" />
                                                </Border>

                                                <!-- UNLINKED overlay -->
                                                <Grid Visibility="{Binding IsUnlinked, Converter={StaticResource BoolToVisConverter}}"
                                                      Background="#4a0f12">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Border Width="42" Height="42" Background="#dc2626" CornerRadius="21"
                                                                HorizontalAlignment="Center" Margin="0,0,0,6">
                                                            <Path Data="{StaticResource IconUnlinked}" Fill="#ffffff"
                                                                  Width="22" Height="22" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="UNLINKED" Foreground="#f87171"
                                                                   FontWeight="ExtraBold" FontSize="12"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="File missing" Foreground="#fca5a5"
                                                                   FontSize="10" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Extension badge top-left -->
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Background="#cc121216" CornerRadius="4"
                                                        Padding="5,2" Margin="6">
                                                    <TextBlock Text="{Binding FileExtension}"
                                                               Foreground="#d4d4d8" FontSize="9" FontWeight="Bold" />
                                                </Border>

                                                <!-- Selection check top-right -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                        Width="18" Height="18" CornerRadius="4"
                                                        Background="{StaticResource BrushAccent}"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}">
                                                    <Path Data="{StaticResource IconCheck}" Fill="#ffffff"
                                                          Width="10" Height="10" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- ── Details & Tag Chips ── -->
                                        <Border Grid.Row="1" Padding="8,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}"
                                                           Foreground="{StaticResource BrushTextPrimary}"
                                                           FontWeight="SemiBold" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding AbsolutePath}" />
                                                <TextBlock Text="{Binding FormattedFileSize}"
                                                           Foreground="{StaticResource BrushTextDim}"
                                                           FontSize="10" Margin="0,2,0,4" />
                                                <ItemsControl ItemsSource="{Binding Tags}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:TagViewModel}">
                                                            <Border Background="{Binding Brush}"
                                                                    BorderBrush="{Binding BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4" Padding="5,2"
                                                                    Margin="0,0,3,3">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               Foreground="#ffffff"
                                                                               FontSize="9" FontWeight="Medium"
                                                                               VerticalAlignment="Center" />
                                                                    <Button Command="{Binding RemoveCommand}"
                                                                            Background="Transparent" BorderThickness="0"
                                                                            Padding="2,0" Margin="3,0,0,0"
                                                                            Cursor="Hand" ToolTip="Remove tag">
                                                                        <Path Data="{StaticResource IconClose}"
                                                                              Fill="#ffffff" Width="7" Height="7"
                                                                              Stretch="Uniform" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="CardBorder" Property="BorderBrush"    Value="{StaticResource BrushAccent}" />
                                        <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                        <Setter TargetName="CardBorder" Property="Background"     Value="#232332" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUnlinked}" Value="True">
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="#7f1d1d" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>

            <!-- ── B. LIST VIEW ── -->
            <ListView x:Name="FileListView"
                      ItemsSource="{Binding FilteredFilesView}"
                      Visibility="{Binding IsListView, Converter={StaticResource BoolToVisConverter}}"
                      SelectionMode="Extended"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{StaticResource BrushTextPrimary}"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      PreviewMouseLeftButtonDown="FileListView_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="FileListView_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="FileListView_PreviewMouseLeftButtonUp"
                      MouseDoubleClick="FileListView_MouseDoubleClick">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="IsSelected"      Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Background"      Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}" />
                        <Setter Property="Padding"         Value="8,6" />
                        <Setter Property="Foreground"      Value="{StaticResource BrushTextPrimary}" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <GridViewRowPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource BrushBgSurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#28283c" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Preview" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                    <Border Width="34" Height="34" CornerRadius="4" ClipToBounds="True" Background="#18181e">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                   Visibility="{Binding IsUnlinked, Converter={StaticResource InverseBoolToVisConverter}}" />
                                            <Grid Visibility="{Binding IsUnlinked, Converter={StaticResource BoolToVisConverter}}" Background="#4a0f12">
                                                <Path Data="{StaticResource IconUnlinked}" Fill="#ef4444"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="File name" Width="260">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Visibility="{Binding IsUnlinked, Converter={StaticResource BoolToVisConverter}}"
                                                Background="#dc2626" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                            <TextBlock Text="UNLINKED" Foreground="#ffffff" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock Text="{Binding FileName}"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   FontWeight="SemiBold"
                                                   ToolTip="{Binding AbsolutePath}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Tags" Width="320">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                    <ItemsControl ItemsSource="{Binding Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TagViewModel}">
                                                <Border Background="{Binding Brush}" BorderBrush="{Binding BorderBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Foreground="#ffffff" FontSize="10" />
                                                        <Button Command="{Binding RemoveCommand}" Background="Transparent"
                                                                BorderThickness="0" Padding="2,0" Margin="3,0,0,0" Cursor="Hand">
                                                            <Path Data="{StaticResource IconClose}" Fill="#ffffff" Width="7" Height="7" Stretch="Uniform" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Ext"           Width="60"  DisplayMemberBinding="{Binding FileExtension}" />
                        <GridViewColumn Header="Size"          Width="80"  DisplayMemberBinding="{Binding FormattedFileSize}" />
                        <GridViewColumn Header="Date modified" Width="140" DisplayMemberBinding="{Binding DateModified, StringFormat='dd/MM/yyyy HH:mm'}" />
                        <GridViewColumn Header="Location"      Width="350">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                    <TextBlock Text="{Binding AbsolutePath}"
                                               Foreground="{StaticResource BrushTextDim}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding AbsolutePath}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Drag & Drop overlay -->
            <Border x:Name="DropOverlay"
                    Background="#dd121216"
                    BorderBrush="{StaticResource BrushAccent}"
                    BorderThickness="3" CornerRadius="12"
                    Margin="20" Visibility="Collapsed"
                    IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconDrop}" Fill="{StaticResource BrushAccent}"
                          Width="64" Height="64" Stretch="Uniform"
                          HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="Drop files or folders here"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="TagThemAll only stores references — your files are never moved or copied."
                               FontSize="14" Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════
             4 ▸ BOTTOM TAGGING DOCK
             ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{StaticResource BrushBgDark}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />   <!-- Selection count -->
                    <ColumnDefinition Width="360" />    <!-- Tag input -->
                    <ColumnDefinition Width="*" />      <!-- Tags on selection -->
                    <ColumnDefinition Width="Auto" />   <!-- Actions -->
                </Grid.ColumnDefinitions>

                <!-- Selection count badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="12"
                            Padding="8,3" Margin="0,0,8,0">
                        <TextBlock Text="{Binding SelectedCount}"
                                   Foreground="#ffffff" FontWeight="Bold" FontSize="11" />
                    </Border>
                    <TextBlock Text="file(s) selected"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Tag input with autocomplete popup -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBox x:Name="TagInputBox"
                             Text="{Binding TagInputText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="TagInputBox_PreviewKeyDown"
                             IsEnabled="{Binding HasSelection}"
                             Padding="10,6">
                        <TextBox.Resources>
                            <VisualBrush x:Key="CuePH" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                <VisualBrush.Visual>
                                    <TextBlock Text="Type a tag (e.g. night) then Enter..."
                                               Foreground="{StaticResource BrushTextDim}"
                                               FontStyle="Italic" FontSize="12" />
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </TextBox.Resources>
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="{StaticResource CuePH}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Add tag confirm button -->
                    <Button Command="{Binding AddTagCommand}"
                            IsEnabled="{Binding HasSelection}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0" Padding="8,4"
                            Style="{StaticResource AccentButton}">
                        <TextBlock Text="+ Tag" FontSize="11" FontWeight="Bold" />
                    </Button>

                    <!-- Fuzzy suggestions popup -->
                    <Popup x:Name="SuggestionsPopup"
                           IsOpen="{Binding IsSuggestionsOpen}"
                           PlacementTarget="{Binding ElementName=TagInputBox}"
                           Placement="Top"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="{StaticResource BrushBgSurface}"
                                BorderBrush="{StaticResource BrushBorderHighlight}"
                                BorderThickness="1" CornerRadius="8"
                                Width="360" MaxHeight="220" Margin="0,0,0,4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox x:Name="SuggestionsListBox"
                                         ItemsSource="{Binding SuggestedTags}"
                                         SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0"
                                         PreviewKeyDown="SuggestionsListBox_PreviewKeyDown"
                                         MouseDoubleClick="SuggestionsListBox_MouseDoubleClick">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                                            <Setter Property="Padding" Value="10,6" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource BrushBgSurfaceHover}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                                                <Setter Property="Foreground" Value="#ffffff" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:TagItem}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconTag}"
                                                      Fill="{StaticResource BrushAccent}"
                                                      Width="12" Height="12" Stretch="Uniform"
                                                      Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Tags on selection -->
                <ScrollViewer Grid.Column="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Tags on selection:"
                                   Foreground="{StaticResource BrushTextDim}"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Visibility="{Binding SelectedFilesCommonTags.Count, Converter={StaticResource CountToVisConverter}}" />
                        <ItemsControl ItemsSource="{Binding SelectedFilesCommonTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TagViewModel}">
                                    <Border Background="{Binding Brush}" BorderBrush="{Binding BorderBrush}"
                                            BorderThickness="1" CornerRadius="6"
                                            Padding="8,4" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="#ffffff"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Button Command="{Binding RemoveCommand}"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="3,0" Margin="6,0,0,0" Cursor="Hand"
                                                    ToolTip="Remove tag from selection">
                                                <Path Data="{StaticResource IconClose}" Fill="#ffffff"
                                                      Width="9" Height="9" Stretch="Uniform" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Action buttons: Relink selected, Relink All, Remove -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RelinkSelectedCommand}"
                            IsEnabled="{Binding HasSelection}"
                            Style="{StaticResource ModernButton}"
                            Margin="0,0,6,0" Padding="10,6"
                            ToolTip="Relink selected UNLINKED files to their new location">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRelink}"
                                  Fill="{StaticResource BrushAccent}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Relink selection" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RelinkAllCommand}"
                            Style="{StaticResource ModernButton}"
                            Margin="0,0,8,0" Padding="10,6"
                            ToolTip="Relink all UNLINKED files">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRelink}"
                                  Fill="{StaticResource BrushTextMuted}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Relink all" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RemoveSelectedFromCatalogCommand}"
                            IsEnabled="{Binding HasSelection}"
                            Style="{StaticResource DangerButton}"
                            Padding="10,6"
                            ToolTip="Remove from catalog (does NOT delete files on disk)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}"
                                  Fill="{StaticResource BrushDanger}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Remove" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════
             5 ▸ STATUS BAR
             ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="{StaticResource BrushBgDarkest}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="4" Margin="0,0,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilteredCount, StringFormat='Shown: {0}'}"
                               Foreground="{StaticResource BrushTextMuted}" FontSize="11" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding TotalCount, StringFormat='Total: {0}'}"
                               Foreground="{StaticResource BrushTextDim}" FontSize="11" Margin="0,0,12,0" />
                    <TextBlock Text="SQLite local"
                               Foreground="{StaticResource BrushTextDim}" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
