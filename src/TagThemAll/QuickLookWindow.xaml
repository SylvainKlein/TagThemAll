<Window x:Class="TagThemAll.QuickLookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Quick Look"
        Icon="Resources/app.ico"
        Height="680" Width="960"
        MinHeight="460" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgDarkest}"
        Foreground="{StaticResource BrushTextPrimary}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />  <!-- Modern Titlebar -->
            <RowDefinition Height="*"  />  <!-- Content Preview -->
            <RowDefinition Height="36" />  <!-- Footer / Info bar -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════
             1 ▸ TITLE BAR (Custom WindowChrome)
             ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgDark}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />     <!-- File Title & Details -->
                    <ColumnDefinition Width="Auto" />  <!-- Navigation (< / >) -->
                    <ColumnDefinition Width="Auto" />  <!-- Actions & Close -->
                </Grid.ColumnDefinitions>

                <!-- Left: File name & extension badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushAccent}" CornerRadius="4"
                            Padding="6,2" Margin="0,0,8,0">
                        <TextBlock x:Name="FileExtBadge" Text="EXT"
                                   Foreground="#ffffff" FontWeight="Bold" FontSize="10" />
                    </Border>
                    <TextBlock x:Name="FileNameText" Text="Filename.ext"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource BrushTextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="FileSizeText" Text="12.4 MB"
                               Foreground="{StaticResource BrushTextDim}" FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Navigation (Previous / Next) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="12,0">
                    <Button Click="PrevButton_Click" Style="{StaticResource ModernButton}"
                            Padding="8,4" Margin="0,0,4,0" ToolTip="Previous file (← Left Arrow)">
                        <TextBlock Text="◀" FontSize="11" />
                    </Button>
                    <TextBlock x:Name="CounterText" Text="1 / 1"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="6,0" />
                    <Button Click="NextButton_Click" Style="{StaticResource ModernButton}"
                            Padding="8,4" ToolTip="Next file (→ Right Arrow)">
                        <TextBlock Text="▶" FontSize="11" />
                    </Button>
                </StackPanel>

                <!-- Right: Actions & Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- Open in default application -->
                    <Button Click="OpenInDefaultApp_Click"
                            Style="{StaticResource AccentButton}"
                            Padding="10,5" Margin="0,0,8,0"
                            ToolTip="Open in default application (Enter)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M10,2 L14,2 L14,6 M14,2 L7,9 M3,5 L3,13 A1,1 0 0,0 4,14 L12,14 A1,1 0 0,0 13,13 L13,10"
                                  Stroke="#ffffff" StrokeThickness="1.5"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Open" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <!-- Show in Explorer -->
                    <Button Click="ShowInExplorer_Click"
                            Style="{StaticResource ModernButton}"
                            Padding="8,5" Margin="0,0,8,0"
                            ToolTip="Reveal in File Explorer (Ctrl+E)">
                        <Path Data="{StaticResource IconFolder}"
                              Fill="{StaticResource BrushTextMuted}"
                              Width="13" Height="13" Stretch="Uniform" />
                    </Button>

                    <!-- Close button -->
                    <Button Click="CloseButton_Click"
                            Style="{StaticResource ModernButton}"
                            Padding="10,5" ToolTip="Close (Esc or Space)">
                        <Path Data="{StaticResource IconClose}"
                              Fill="{StaticResource BrushTextMuted}"
                              Width="10" Height="10" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════
             2 ▸ CONTENT PREVIEW AREA
             ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Background="#0d0d10">

            <!-- ── A. IMAGE PREVIEW ── -->
            <Grid x:Name="ImageContainer" Visibility="Collapsed">
                <Image x:Name="ImageViewer"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Margin="12" />
            </Grid>

            <!-- ── B. VIDEO / AUDIO PREVIEW ── -->
            <Grid x:Name="MediaContainer" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Media player element with orientation transform -->
                <Grid Grid.Row="0" ClipToBounds="True" Background="#000000">
                    <MediaElement x:Name="MediaPlayer"
                                  LoadedBehavior="Manual"
                                  UnloadedBehavior="Manual"
                                  ScrubbingEnabled="True"
                                  Stretch="Uniform"
                                  MediaOpened="MediaPlayer_MediaOpened"
                                  MediaEnded="MediaPlayer_MediaEnded"
                                  MouseLeftButtonDown="MediaPlayer_MouseLeftButtonDown"
                                  Cursor="Hand">
                        <MediaElement.LayoutTransform>
                            <RotateTransform x:Name="MediaRotation" Angle="0" />
                        </MediaElement.LayoutTransform>
                    </MediaElement>
                </Grid>

                <!-- Player controls overlay -->
                <Border Grid.Row="1" Background="#e6141418"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="0,1,0,0" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /> <!-- Play/Pause -->
                            <ColumnDefinition Width="Auto" /> <!-- Time Current -->
                            <ColumnDefinition Width="*"    /> <!-- Seek Slider -->
                            <ColumnDefinition Width="Auto" /> <!-- Time Total -->
                            <ColumnDefinition Width="Auto" /> <!-- Rotate & Mute / Volume -->
                        </Grid.ColumnDefinitions>

                        <!-- Play / Pause -->
                        <Button x:Name="PlayPauseButton" Grid.Column="0"
                                Click="PlayPause_Click"
                                Style="{StaticResource ModernButton}"
                                Padding="10,4" Margin="0,0,10,0">
                            <TextBlock x:Name="PlayPauseIcon" Text="⏸" FontSize="14" FontWeight="Bold" />
                        </Button>

                        <!-- Time text -->
                        <TextBlock x:Name="CurrentTimeText" Grid.Column="1"
                                   Text="00:00" Foreground="{StaticResource BrushTextPrimary}"
                                   FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />

                        <!-- Seek slider -->
                        <Slider x:Name="TimelineSlider" Grid.Column="2"
                                VerticalAlignment="Center"
                                Minimum="0" Maximum="100" Value="0"
                                PreviewMouseDown="TimelineSlider_PreviewMouseDown"
                                PreviewMouseUp="TimelineSlider_PreviewMouseUp"
                                ValueChanged="TimelineSlider_ValueChanged"
                                Margin="0,0,10,0" />

                        <!-- Total time -->
                        <TextBlock x:Name="TotalTimeText" Grid.Column="3"
                                   Text="00:00" Foreground="{StaticResource BrushTextMuted}"
                                   FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />

                        <!-- Rotate 90° & Mute / Unmute -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button Click="RotateButton_Click"
                                    Style="{StaticResource ModernButton}"
                                    Padding="8,4" Margin="0,0,6,0"
                                    ToolTip="Rotate 90° clockwise (R)">
                                <TextBlock Text="⟳" FontSize="13" />
                            </Button>

                            <Button x:Name="MuteButton"
                                    Click="MuteButton_Click"
                                    Style="{StaticResource ModernButton}"
                                    Padding="8,4">
                                <TextBlock x:Name="MuteIcon" Text="🔊" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── C. TEXT / CODE PREVIEW ── -->
            <Grid x:Name="TextContainer" Visibility="Collapsed" Margin="16">
                <Border Background="{StaticResource BrushBgSurface}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1" CornerRadius="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="16">
                        <TextBox x:Name="TextViewer"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 Foreground="#e4e4e7"
                                 BorderThickness="0"
                                 FontFamily="Consolas, 'Cascadia Code', monospace"
                                 FontSize="12"
                                 TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ── D. GENERIC / OTHER FILE PREVIEW ── -->
            <Grid x:Name="GenericContainer" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <Border Width="96" Height="96" CornerRadius="16"
                            Background="{StaticResource BrushBgSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Image x:Name="GenericThumbnailImage" Stretch="Uniform" Margin="12" />
                    </Border>

                    <TextBlock x:Name="GenericFileName" Text="Filename.ext"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />

                    <TextBlock x:Name="GenericFileInfo" Text="14.2 MB • Modified 12/04/2026"
                               FontSize="13" Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center" Margin="0,0,0,24" />

                    <Button Click="OpenInDefaultApp_Click"
                            Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Center" Padding="18,10">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M10,2 L14,2 L14,6 M14,2 L7,9 M3,5 L3,13 A1,1 0 0,0 4,14 L12,14 A1,1 0 0,0 13,13 L13,10"
                                  Stroke="#ffffff" StrokeThickness="1.5"
                                  Width="14" Height="14" Stretch="Uniform"
                                  Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Open in default application" FontWeight="Bold" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ── E. UNLINKED ERROR BANNER ── -->
            <Border x:Name="UnlinkedBanner"
                    Background="#dd450a0a"
                    BorderBrush="#ef4444"
                    BorderThickness="1" CornerRadius="8"
                    Padding="16,12" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconUnlinked}" Fill="#ef4444"
                          Width="36" Height="36" Stretch="Uniform"
                          HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="File Missing (UNLINKED)" FontWeight="Bold" FontSize="16"
                               Foreground="#fca5a5" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock x:Name="UnlinkedPathText" Text="C:\path\to\missing_file.ext"
                               Foreground="#fecaca" FontSize="12" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="600" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════
             3 ▸ FOOTER / STATUS BAR
             ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushBgDark}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Full Path -->
                <TextBlock x:Name="PathText" Text="C:\path\to\file.ext"
                           Foreground="{StaticResource BrushTextDim}"
                           FontSize="11" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <!-- Right: Keyboard hints & details -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailsText" Text=""
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="11" Margin="0,0,16,0" />
                    <TextBlock Text="Space / Esc to close • ← → to browse • Enter to open"
                               Foreground="{StaticResource BrushTextDim}"
                               FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
